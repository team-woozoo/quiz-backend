# 서버에서 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다
APP_IMAGE=quiz-backend:latest

POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=

# Base64 로 32 바이트 이상. 서버에서 openssl rand -base64 48 로 만든다. 바꾸면 발급된 토큰이 모두 무효가 된다
JWT_SECRET=

# 학교에서 발급한 LLM 게이트웨이 주소와 키. 키마다 사용 한도가 있어 다른 곳에 쓰지 않는다
LLM_BASE_URL=
LLM_API_KEY=

# 이 파일에는 비밀값과 DB 이름만 둔다. 모델, 출력 상한, 일일 한도 같은 조정 값은 compose 가 넘기지 않으므로
# 여기에 적어도 쓰이지 않는다. application-*.properties 에서 바꾸고 배포한다
